{
  "name": "faidahq",
  "private": true,
  "description": "FaidaHQ website and Hospitality Assistant. No build step: the site is static HTML/CSS/JS.",
  "scripts": {
    "seed": "node scripts/build-seed.mjs",
    "test": "npm run test:functions && npm run test:e2e",
    "test:functions": "deno test --allow-env tests/functions",
    "test:db": "bash tests/db/run.sh",
    "test:e2e": "node --test tests/e2e/*.test.mjs",
    "serve": "node -e \"import('./tests/e2e/server.mjs').then(m=>m.startServer(8080)).then(s=>console.log('Serving on '+s.url))\""
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.45.4"
  }
}
